{
  "name": "@repo/agent-core",
  "version": "0.0.0",
  "private": true,
  "description": "Browser agent core: agent loop, memory, actions, transport contract. Consumed by apps/ai (server) and apps/extension (client).",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.mts", "default": "./dist/index.mjs" },
      "require": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
    },
    "./memory": {
      "import": { "types": "./dist/memory/index.d.mts", "default": "./dist/memory/index.mjs" },
      "require": { "types": "./dist/memory/index.d.ts", "default": "./dist/memory/index.js" }
    },
    "./actions": {
      "import": { "types": "./dist/actions/index.d.mts", "default": "./dist/actions/index.mjs" },
      "require": { "types": "./dist/actions/index.d.ts", "default": "./dist/actions/index.js" }
    },
    "./connectors": {
      "import": { "types": "./dist/connectors/index.d.mts", "default": "./dist/connectors/index.mjs" },
      "require": { "types": "./dist/connectors/index.d.ts", "default": "./dist/connectors/index.js" }
    },
    "./transport": {
      "import": { "types": "./dist/transport/index.d.mts", "default": "./dist/transport/index.mjs" },
      "require": { "types": "./dist/transport/index.d.ts", "default": "./dist/transport/index.js" }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "baml:generate": "baml-cli generate --from baml_src",
    "baml:check": "baml-cli check --from baml_src"
  },
  "dependencies": {
    "@boundaryml/baml": "^0.220.0",
    "@paralleldrive/cuid2": "^2.2.2",
    "@trpc/client": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "ansis": "^4.1.0",
    "eventemitter3": "^5.0.1",
    "object-hash": "^3.0.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "sharp": "^0.34.3",
    "ws": "^8.18.0",
    "zod": "^3.24.4",
    "zod-to-json-schema": "^3.24.5"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "@types/object-hash": "^3.0.6",
    "@types/ws": "^8.5.10",
    "eslint": "^9.26.0",
    "tsup": "^8.5.1",
    "typescript": "5.8.2"
  }
}
