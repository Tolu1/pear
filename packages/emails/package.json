{
  "name": "@repo/emails",
  "version": "0.0.0",
  "private": true,
  "description": "Transactional email templates (React Email) and their renderers. Consumed by apps/backend.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "email dev --dir src/templates --port 3030",
    "check-types": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-email": "6.9.0"
  },
  "devDependencies": {
    "@react-email/ui": "6.9.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.26.0",
    "tsup": "^8.5.1",
    "typescript": "5.8.2"
  }
}
