{
  "manifest_version": 3,
  "name": "Pear",
  "version": "0.1.0",
  "description": "Buy anything online using crypto",
  "permissions": ["tabs", "sidePanel", "debugger", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_icon": {
      "16": "icon.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
