{
  "manifest_version": 3,
  "name": "Pear",
  "version": "0.2.0",
  "description": "Early access preview of Pear's browser agent",
  "permissions": ["tabs", "activeTab", "sidePanel", "debugger"],
  "host_permissions": [
    "*://stripe-payments-demo.appspot.com/*",
    "*://ai.pearextension.com/*",
    "http://localhost/*"
  ],
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_icon": {
      "16": "icon.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "content_scripts": [
    {
      "matches": ["*://stripe-payments-demo.appspot.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
