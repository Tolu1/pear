{
  "name": "extension",
  "private": true,
  "version": "0.1.0-alpha",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:playground": "vite --mode playground",
    "build": "tsc -b && vite build",
    "build:playground": "tsc -b && vite build --mode playground",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "lint": "eslint .",
    "generate:api-types": "node scripts/generate-types.mjs",
    "release": "pnpm build && mkdir -p releases && cd dist && zip -r ../releases/pear-extension-v$npm_package_version.zip .",
    "release:playground": "pnpm build:playground && mkdir -p releases && cd dist && zip -r ../releases/pear-extension-playground-v$npm_package_version.zip .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@repo/agent-core": "workspace:*",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@metamask/providers": "^22.1.0",
    "@mui/material": "^7.2.0",
    "@radix-ui/react-slot": "^1.2.2",
    "@tailwindcss/vite": "^4.1.6",
    "@tanstack/react-query": "^5.76.1",
    "@tanstack/react-router": "^1.120.3",
    "@tanstack/react-router-devtools": "^1.120.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.510.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.1.6",
    "viem": "^2.29.2",
    "wagmi": "^2.15.3",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/chrome": "^0.0.321",
    "@types/node": "^22.15.17",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react-swc": "^3.9.0",
    "dotenv": "^16.6.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tw-animate-css": "^1.2.9",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-plugin-node-polyfills": "0.23.0"
  }
}
